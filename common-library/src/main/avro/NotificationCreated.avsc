{
  "namespace": "com.artem.common.notification.avro",
  "type": "record",
  "name": "NotificationCreated",
  "fields": [
    {
      "name": "eventId",
      "type": "string"
    },
    {
      "name": "notificationType",
      "type": "string"
    },
    {
      "name": "message",
      "type": "string"
    },
    {
      "name": "userUid",
      "type": "string"
    },
    {
      "name": "email",
      "type": ["null", "string"],
      "default": null
    },
    {
      "name": "subject",
      "type": "string"
    },
    {
      "name": "createdBy",
      "type": "string"
    },
    {
      "name": "createdAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    }
  ]
}